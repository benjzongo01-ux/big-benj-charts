# Copie ce fichier en « .env » puis remplis ce dont tu as besoin. Ne partage jamais ton .env.

# false = usage personnel sans connexion. true = comptes obligatoires (version publique).
AUTH_REQUIRED=false
# Autorise les stratégies Python personnalisées. Mets false en version publique.
ALLOW_CUSTOM_CODE=true
# Clé de signature des sessions (laisse vide en local : elle est générée automatiquement).
SECRET_KEY=

# Twelve Data (optionnel, clé gratuite sur twelvedata.com)
TWELVEDATA_API_KEY=

# MetaTrader 5 (optionnel). Laisse vide pour utiliser le compte déjà ouvert dans ton terminal MT5.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
